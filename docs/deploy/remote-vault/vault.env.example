# Example .env for ONE vault (docker-compose.yml in this folder).
# add-vault.sh writes the real file to /opt/obsidian-vaults/<slug>/.env
# (mode 600). To do it by hand: copy this file to .env and edit it.
# Never commit the real .env: it holds the web UI password.

# Short, lowercase name of the vault. Used for the container name
# (obsidian-<slug>), the config folder (config-<slug>) and the path
# inside the container (/vaults/<slug>). Letters, digits, - and _ only.
VAULT_SLUG=notes

# The server's address on the WireGuard tunnel. Ports are published on this
# address only, so nothing is reachable from the public interface.
WG_IP=10.8.0.1

# Port of the Selkies web UI on the host (container side is always 3001).
# One per vault: 3001, 3002, 3003...
UI_PORT=3001

# Port of the Obsidian "Local REST API" plugin, same number on host and
# container. One per vault: 27180, 27181, 27182...
# It must match the plugin's data.json (insecurePort for HTTP, or port for HTTPS).
API_PORT=27180

# Folder on the host that holds the vault's notes (can be a mount of a
# network share). Mounted at /vaults/<slug> in the container.
VAULT_DIR=/srv/vaults/notes

# Basic auth for the web UI. Pick your own; never reuse a real password.
CUSTOM_USER=obsidian
PASSWORD=change-me

# Owner of the files written in VAULT_DIR and config-<slug>
# (`id -u` / `id -g` of the user who should own them).
PUID=1000
PGID=1000

# Time zone, e.g. Europe/Paris, America/New_York, Etc/UTC.
TZ=Etc/UTC
