{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/hot-cache-load.mjs\""
          },
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/check-router-update.mjs\""
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/hot-cache-load.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/wiki-query-first-nudge.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__obsidian-router__write_file|mcp__obsidian-router__patch_file|mcp__obsidian-router__append_to_file|mcp__obsidian-router__set_frontmatter|mcp__obsidian-router__merge_frontmatter|mcp__obsidian-router__delete_file|mcp__obsidian-router__move_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/wiki-autocommit.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/doc-propagation-checker.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/vault-link-linter.mjs\""
          },
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/hot-cache-update-prompt.mjs\""
          }
        ]
      }
    ]
  }
}
