{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/hot-cache-load.mjs\""
          },
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/check-router-update.mjs\""
          },
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/session-auto-journal.mjs\""
          },
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/vault-doc-startup-check.mjs\""
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/hot-cache-load.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/wiki-query-first-nudge.mjs\""
          },
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/decisions-recall.mjs\""
          },
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/session-auto-journal.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*(?:write_file|patch_file|append_to_file|set_frontmatter|merge_frontmatter|delete_file|move_file|execute_template|write_bundle)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/wiki-autocommit.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/doc-propagation-checker.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|mcp__.*(?:write_file|patch_file|append_to_file|set_frontmatter|merge_frontmatter|delete_file|move_file|execute_template|write_bundle)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/session-auto-journal.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/vault-link-linter.mjs\""
          },
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/hot-cache-update-prompt.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<router-repo>/hooks/session-auto-journal.mjs\""
          }
        ]
      }
    ]
  }
}
