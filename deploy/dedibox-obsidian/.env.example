# deploy/dedibox-obsidian/.env.example
# Per-vault deployment variables. Copy to a private location and fill in.
# NEVER commit a filled copy — it contains secrets. (.env is gitignored.)

# --- identity ---
VAULT_NAME=tribu                  # lowercase slug [a-z0-9-]
REST_PORT=27145                   # the Local REST API port the plugin serves
MODE=wg                           # wg | public | lan

# --- mode-specific host/domain ---
WG_HOST=10.8.0.1                  # (wg)     a 10.8.0.x address
# LAN_HOST=192.168.0.10           # (lan)    an IPv4 on the LAN
# API_DOMAIN=tribu-api.kiviri.fr  # (public) the HTTPS hostname for the REST API
# GUI_DOMAIN=tribu.kiviri.fr      # (optional) HTTPS hostname for the Selkies web viewer
# GUI_PORT=28145                  # (optional) host port for the GUI; default REST_PORT+1000 (unique per vault)

# --- metadata ---
DESCRIPTION=Mémoire IA famille
SENSITIVE=false                   # true → medical/sensitive; forces MODE=wg (forbids public AND lan)
TIMEOUT_MS=15000
TLS_INSECURE=false                # true → router skips TLS cert verification (https baseUrl behind a self-signed / internal-CA endpoint). Default false.

# --- secrets (fill in privately; the generator uses placeholders if absent) ---
# API_KEY=<the vault's Local REST API token — bare, no "Bearer ">
# BASIC_PASSWORD=<the Selkies GUI password>

# --- container ---
CONFIG_PATH=/srv/vaults/tribu     # host dir mounted to /config (plain markdown vault)
PUID=1000
PGID=1000
TZ=Europe/Paris
HARDEN=true                       # disable in-GUI terminal/sudo (recommended)
