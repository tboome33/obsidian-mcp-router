{
  "name": "obsidian-mcp-router",
  "version": "0.10.1",
  "description": "MCP server that routes tool calls to multiple Obsidian vaults (local or remote) over the Local REST API plugin.",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {
    "obsidian-mcp-router": "./bin/obsidian-mcp-router.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "examples/",
    "skills/",
    "commands/",
    "agents/",
    "hooks/",
    "templates/",
    ".claude-plugin/",
    "README.md",
    "ROADMAP.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node bin/obsidian-mcp-router.mjs",
    "test": "node --test tests/registry.test.mjs tests/sanitize.test.mjs tests/idf-score.test.mjs tests/wiki-fingerprint.test.mjs tests/readonly.test.mjs tests/user-id-audit.test.mjs",
    "setup-vault": "node scripts/setup-vault.mjs",
    "status": "node scripts/setup-vault.mjs --status"
  },
  "keywords": [
    "obsidian",
    "mcp",
    "model-context-protocol",
    "claude",
    "router",
    "rest-api"
  ],
  "author": "tboome33",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "undici": "^7.0.0"
  }
}
